# Supabase client keys para el frontend
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-key>

# Modo mantenimiento: en "true" la app muestra el cartel de pausa y no carga
# nada más. Cualquier otro valor (o ausente) = app habilitada.
VITE_APP_PAUSADA=false

# Asistente de IA (pantalla /asistente, solo gerencia).
# Va SIN prefijo VITE_ a propósito: Vite inlinea en el bundle todo lo que
# empieza con VITE_, y una clave ahí queda publicada. Estas las lee la función
# de servidor api/asistente.js y nunca llegan al navegador.
GROQ_API_KEY=<tu-clave-de-console.groq.com>
# Opcional: modelo de Groq. Por defecto llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile
# La función consulta con la clave anon (para que RLS siga mandando). Si ya
# tenés VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY cargadas, las toma de ahí.
SUPABASE_ANON_KEY=<tu-anon-key>

# Claves usadas por el script de admin (no subir a git)
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>

# Datos de ejemplo para crear el usuario admin
ADMIN_EMAIL=angel@neumaticos.com
ADMIN_PASSWORD=Demo1234
ADMIN_NOMBRE=Administrador